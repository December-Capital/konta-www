# Apache configuration for the shared host serving konta.md.
#
# Hostinger may already do the https and www redirects in its own panel. If it does, the two
# rules below are harmless duplicates; if it does not, they are the difference between one
# canonical address and four. Delete the block rather than fighting it if a redirect loops.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # https only.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # konta.md is canonical; www redirects to it.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Older Apache builds do not know woff2 and send it as text, which makes the browser refuse the
# font and silently fall back. Declaring it costs nothing if the server already knew.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# The fonts and the logo are content-addressed by name and never change in place, so they can be
# cached hard. The pages and the language catalogues change whenever the copy does, so they are
# revalidated every time.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Nothing on this site is meant to be framed, and no page needs a referrer sent onward.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# A missing page returns the home page's 404, not the host's branded one.
ErrorDocument 404 /index.html
