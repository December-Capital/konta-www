# Apache configuration for the shared host serving konta.md.
#
# Hostinger may already do the https and www redirects in its own panel. If it does, the two
# rules below are harmless duplicates; if it does not, they are the difference between one
# canonical address and four. Delete the block rather than fighting it if a redirect loops.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # https only.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # konta.md is canonical; www redirects to it.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# If the document root is ever a git checkout rather than a copied folder (which it is the
# moment Hostinger's git integration is pointed at this repository), then the repository's own
# files are sitting in the web root. None of them are meant to be fetched over HTTP.
#
# .git is the one that matters: a served .git directory hands over the full history, every
# branch, and anything ever committed by mistake. 404 rather than 403, so a probe learns nothing
# from the answer.
# /.well-known/ is meant to be fetched (security.txt), and none of the patterns below match it.
RedirectMatch 404 (?i)/\.git(/|$)
RedirectMatch 404 (?i)/tools/
RedirectMatch 404 (?i)\.(md|py|yml|yaml|lock)$

# Older Apache builds do not know woff2 and send it as text, which makes the browser refuse the
# font and silently fall back. Declaring it costs nothing if the server already knew.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/json .json
</IfModule>

# Caching, and the reason for each tier.
#
# Everything that carries content or behaviour revalidates on every visit: a conditional request
# is one round trip and a 304 is a few bytes, and the alternative is a visitor pinned to an old
# stylesheet for a week with no way to know. This host defaults css and js to max-age=604800,
# which is exactly how that happened once already, so they are named here explicitly.
#
# Fonts are the one exception. They are large, they are subset files, and they change only when
# somebody deliberately regenerates them, at which point the CDN cache has to be purged or the
# files renamed, because a year is a long time to serve the wrong one.
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.png$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  <FilesMatch "\.(html|json|css|js|ics|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Nothing on this site is meant to be framed, and no page needs a referrer sent onward.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The PHP version is nobody's business. trimite.php also removes it itself, since expose_php
  # cannot be switched off from here.
  Header always unset X-Powered-By

  # A year of https only, after the first visit. Without includeSubDomains, on purpose:
  # autoconfig.konta.md and autodiscover.konta.md point at Hostinger's mail servers, which hold no
  # certificate for those names, so mail clients reach them over plain http, and a client that
  # had picked up includeSubDomains from konta.md would refuse them. app.konta.md and
  # admin.konta.md send their own Strict-Transport-Security, and www.konta.md only redirects
  # here. Add includeSubDomains the day those two mail names are gone or have a certificate.
  Header always set Strict-Transport-Security "max-age=31536000"

  # What a page may load, which is what the site already does and no more: everything from
  # konta.md itself, plus the status page's check of app.konta.md (connect-src). The one inline
  # script, the theme and the remembered language set before first paint, is identical on every
  # page, the /ru/ and /en/ copies included, and is allowed by its hash. If that script changes by
  # a single character the hash changes too, and the theme flashes until this line is updated
  # (tools/package.py refuses to package a page whose inline script this hash does not allow):
  #   python -c "import re,hashlib,base64;s=re.search(r'<script>(.*?)</script>',open('index.html',encoding='utf-8').read(),re.S).group(1);print(base64.b64encode(hashlib.sha256(s.encode()).digest()).decode())"
  # The JSON-LD and data-seed blocks are data, not scripts, and need nothing. No inline styles
  # exist, so style-src is 'self' alone. The form posts to its own handler (form-action), which
  # redirects back to /contact/. Hostinger adds its own "upgrade-insecure-requests" CSP header on
  # this host; a second policy only ever narrows, and it is repeated here so it holds without them.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-VCpxrelFtcwIxnpNfCSfM3IGONLhtyI2GwxHTL7wqHA='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://app.konta.md; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"

  # No page needs a camera, a microphone, the visitor's location, a payment sheet or a USB device,
  # so none can ask, nor anything embedded in it.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# A missing page gets our own 404 page, with a real 404 status, not the host's branded one.
ErrorDocument 404 /404.html

# The sitemap and the calendar's RSS are XML; some older builds serve it as text. robots.txt and
# .well-known/security.txt are plain text, and RFC 9116 wants the charset said. The calendar's
# feeds are iCalendar (RFC 5545), which calendar applications check before subscribing.
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/calendar .ics
  AddCharset utf-8 .txt .ics .xml
</IfModule>
